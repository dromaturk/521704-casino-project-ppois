#include <iostream>
#include <fstream>
#include <string>
#include <random>
#include <thread>
#include <chrono>
#ifdef _WIN32
#include <windows.h>
#endif

using namespace std;

const string SAVE_FILE = "save.txt";
const string NAMES[3] = {"Петух", "Мужик", "Пахан"};
const long long START_COINS[3] = {100, 1000, 10000};
const int BETS[4] = {1, 10, 100, 1000};

// ---------- Сохранение / загрузка ----------
// Формат save.txt: первая строка - номер персонажа (1-3), вторая - монеты
bool loadGame(int &character, long long &coins) {
    ifstream f(SAVE_FILE);
    if (!f) return false;
    if (!(f >> character >> coins)) return false;
    return character >= 1 && character <= 3 && coins >= 0;
}

void saveGame(int character, long long coins) {
    ofstream f(SAVE_FILE, ios::trunc);
    f << character << "\n" << coins << "\n";
}

// ---------- Ввод ----------
int readInt(const string &prompt, int lo, int hi) {
    while (true) {
        cout << prompt;
        string line;
        if (!getline(cin, line)) exit(0);
        try {
            size_t pos;
            int v = stoi(line, &pos);
            if (pos == line.size() && v >= lo && v <= hi) return v;
        } catch (...) {}
        cout << "Некорректный ввод. Введите число от " << lo << " до " << hi << ".\n";
    }
}

int chooseCharacter() {
    cout << "\nВыберите персонажа:\n";
    for (int i = 0; i < 3; i++)
        cout << "  " << i + 1 << ". " << NAMES[i] << " - " << START_COINS[i] << " монет\n";
    return readInt("Ваш выбор: ", 1, 3);
}

// ---------- Один спин ----------
// Выводит три цифры по очереди в одну строку, возвращает результат
void spin(mt19937 &rng, int d[3]) {
    uniform_int_distribution<int> dist(0, 9);
    cout << "\n  [ ";
    cout.flush();
    for (int i = 0; i < 3; i++) {
        this_thread::sleep_for(chrono::milliseconds(700));
        d[i] = dist(rng);
        cout << d[i] << " ";
        cout.flush();
    }
    cout << "]\n\n";
}

int main() {
#ifdef _WIN32
    SetConsoleOutputCP(CP_UTF8);
    SetConsoleCP(CP_UTF8);
#endif
    mt19937 rng(random_device{}());

    int character = 0;
    long long coins = 0;
    bool haveSave = loadGame(character, coins);

    while (true) {
        // ----- Выбор персонажа / продолжение -----
        bool cont = false;
        if (haveSave && coins > 0) {
            cout << "Найдено сохранение: " << NAMES[character - 1]
                 << ", монет: " << coins << "\n";
            cout << "  1. Продолжить\n  2. Новая игра\n";
            cont = (readInt("Ваш выбор: ", 1, 2) == 1);
        }
        if (!cont) {
            character = chooseCharacter();
            coins = START_COINS[character - 1];
            saveGame(character, coins);
        }

        // ----- Уровень сложности -----
        int level = readInt("\nВыберите уровень сложности (1-9): ", 1, 9);
        long long winMult = level * 11;
        long long maxMult = level * 111;
        cout << "Обычная победа: x" << winMult << ", MAXWIN (000): x" << maxMult << "\n";

        // ----- Игровой цикл -----
        while (coins > 0) {
            cout << "\n==============================\n";
            cout << NAMES[character - 1] << " | Монет: " << coins
                 << " | Уровень: " << level << "\n";

            // доступные ставки
            int avail[4], n = 0;
            for (int b : BETS)
                if (b <= coins) avail[n++] = b;

            cout << "Ставка (0 - выход):";
            for (int i = 0; i < n; i++) cout << " " << avail[i];
            cout << "\n";

            int bet;
            while (true) {
                bet = readInt("Ваша ставка: ", 0, 1000);
                if (bet == 0) break;
                bool ok = false;
                for (int i = 0; i < n; i++) ok = ok || (avail[i] == bet);
                if (ok) break;
                cout << "Такая ставка недоступна.\n";
            }
            if (bet == 0) {
                saveGame(character, coins);
                cout << "Игра сохранена. До встречи!\n";
                return 0;
            }

            int d[3];
            spin(rng, d);

            if (d[0] == d[1] && d[1] == d[2]) {
                if (d[0] == 0) {
                    long long win = bet * maxMult;
                    coins += win;
                    cout << "*** MAXWIN!!! *** +" << win << " монет\n";
                } else {
                    long long win = bet * winMult;
                    coins += win;
                    cout << "Победа! +" << win << " монет\n";
                }
            } else {
                coins -= bet;
                cout << "Проигрыш. -" << bet << " монет\n";
            }
            saveGame(character, coins);
        }

        // ----- Банкротство -----
        cout << "\nУ вас закончились монеты. Игра окончена!\n";
        saveGame(character, 0);
        haveSave = true; // монеты = 0, поэтому предложим только новую игру
    }
}